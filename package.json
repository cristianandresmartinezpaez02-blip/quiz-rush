{
  "name": "quiz-rush",
  "private": true,
  "version": "0.1.0",
  "description": "⚡ Quiz_Rush — plataforma de quizzes en tiempo real",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run infra:up && npm run db:deploy && turbo run dev",
    "dev:apps": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "search:up": "docker compose --profile search up -d --wait meilisearch",
    "search:reindex": "node scripts/search-reindex.mjs",
    "db:generate": "npm run generate -w @quiz-rush/db",
    "db:migrate": "npm run migrate:dev -w @quiz-rush/db",
    "db:deploy": "npm run migrate:deploy -w @quiz-rush/db",
    "db:seed": "npm run seed -w @quiz-rush/db",
    "db:studio": "npm run studio -w @quiz-rush/db",
    "admin:grant": "npm run admin:grant -w @quiz-rush/db --",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true
  }
}
