# ─────────────────────────────────────────────────────────────
#  Quiz_Rush — variables de entorno
#  Copia este archivo a .env  (npm run setup lo hace por ti)
# ─────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────
# Conexión de las apps (a través de PgBouncer, puerto 6432)
DATABASE_URL="postgresql://quizrush:quizrush@localhost:6432/quizrush"
# Conexión directa (migraciones de Prisma, sin PgBouncer)
DIRECT_DATABASE_URL="postgresql://quizrush:quizrush@localhost:5432/quizrush"
# Réplica de solo lectura (opcional; si está vacía se usa DATABASE_URL)
DATABASE_READ_URL=""

# ── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── App web ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# ── Google OAuth (opcional; sin esto el botón de Google se oculta) ──
# Callback autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Correo (enlaces mágicos). En local usa Mailpit: http://localhost:8025 ──
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Quiz_Rush <no-reply@quizrush.local>"

# ── Archivos ─────────────────────────────────────────────────
# Si defines Cloudinary se usa su CDN; si no, se guardan en disco (solo desarrollo)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_DIR=".uploads"

# ── Servidor de tiempo real ──────────────────────────────────
REALTIME_PORT="4000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
REALTIME_CORS_ORIGIN="http://localhost:3000"
# (Opcional) URL interna para descargar las claves públicas de los JWT; por defecto
# se usa la pública: $BETTER_AUTH_URL/api/auth/jwks
REALTIME_JWKS_URL=""

# ── IA (Fase 6) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Modelo de Claude (por defecto claude-opus-5-5)
AI_MODEL=""
# AI_MOCK=1 → respuestas simuladas sin llamar al API (pruebas y demos sin clave)
AI_MOCK=""
# Límites diarios por usuario: generaciones de quiz y ayudas del editor
AI_DAILY_GENERATIONS=20
AI_DAILY_ASSISTS=100

# ── Notificaciones push (Fase 7) ─────────────────────────────
# `npm run setup` las genera. Sin ellas, la opción de push no aparece.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto para los servicios de push (mailto: o https:)
VAPID_SUBJECT="mailto:admin@quizrush.dev"

# ── Worker y trabajos en segundo plano (Fase 8) ─────────────
# Secreto entre la web y el worker (`npm run setup` lo genera). Sin worker, la web hace los
# trabajos ella misma tras responder.
JOBS_SECRET=""
# URL con la que el worker llega a la web (red interna en producción)
WEB_INTERNAL_URL="http://localhost:3000"
WORKER_PORT=4100
WORKER_CONCURRENCY=4

# ── Búsqueda externa opcional (Meilisearch) ─────────────────
# Sin MEILI_URL la búsqueda usa PostgreSQL. Con ella: `npm run search:reindex` la primera vez.
MEILI_URL=""
MEILI_MASTER_KEY=""

# ── Observabilidad ──────────────────────────────────────────
# Protege /api/metrics de la web (Prometheus: `Authorization: Bearer <METRICS_TOKEN>`)
METRICS_TOKEN=""
# Errores a Sentry (opcional; sin DSN no se envía nada)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Cabecera con la IP real del cliente que pone (y sobrescribe) el proxy de delante. Se usa para
# los límites de peticiones. Vercel / nginx / Railway: x-real-ip · Cloudflare: cf-connecting-ip
CLIENT_IP_HEADER="x-real-ip"

# Caché de página completa para visitantes sin sesión (portada, Biblioteca, fichas de quiz).
# Segundos; por defecto 30 en producción y apagada en desarrollo. 0 la desactiva.
PAGE_CACHE_SECONDS=""
# Conexiones a la base de datos por réplica (× réplicas debe caber en PgBouncer)
DATABASE_POOL_MAX=10
